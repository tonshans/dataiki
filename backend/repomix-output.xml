    list_snippets,
    test_connection,
    update_connection,
    update_snippet,
)
from backend.schemas import (
    ConnectionCreate,
    ConnectionReadOnlyPatch,
    ConnectionTestRequest,
    JanitorPurgeRequest,
    ProjectCreate,
    SnippetCreate,
)

router = APIRouter(prefix="/api/system", tags=["System & Settings"])


@router.get("/features")
def get_feature_flags() -> Dict[str, bool]:
