"""Standalone Production REST API for Dataiki Model.

Generated by Dataiki Standalone Exporter (Zero Vendor Lock-in).
Project: {{ project_key }} | Model: {{ algorithm }} | Version: v{{ version }}
"""

from __future__ import annotations

import os
from pathlib import Path
from typing import Any, Dict, List, Optional, Union

import joblib
import numpy as np
import polars as pl
from fastapi import FastAPI, HTTPException, status
from pydantic import BaseModel, Field

from dataiki_recipe import RecipeValidationError, replay_frozen_lineage

# Load immutable bundle
BUNDLE_PATH = Path(__file__).parent / "bundle.joblib"
if not BUNDLE_PATH.exists():
    raise FileNotFoundError(f"Missing bundle.joblib at {BUNDLE_PATH}")

bundle = joblib.load(BUNDLE_PATH)
model = bundle["model"]
transformer = bundle["transformer"]
label_encoder = bundle.get("label_encoder")
feature_columns: List[str] = bundle.get("feature_columns", [])
target_column: str = bundle.get("target_column", "target")
task_type: str = bundle.get("task_type", "classification")
algorithm: str = bundle.get("algorithm", "Model")
frozen_lineage: Dict[str, Any] = bundle.get("frozen_lineage", {})
metrics: Dict[str, float] = bundle.get("metrics", {})
hyperparameters: Dict[str, Any] = bundle.get("hyperparameters", {})

app = FastAPI(
    title=f"Dataiki Standalone API - {algorithm} v{bundle.get('version', 1)}",
    description=f"Automated standalone REST microservice for project '{{ project_key }}'.",
    version=f"{bundle.get('version', 1)}.0.0",
)


class PredictionRequest(BaseModel):
    """Payload for tabular prediction."""
    records: Union[Dict[str, Any], List[Dict[str, Any]]] = Field(
        ...,
        description="Single JSON record or list of JSON records matching model features.",
    )


def _prepare_features(data: Union[Dict[str, Any], List[Dict[str, Any]]]) -> np.ndarray:
    if isinstance(data, dict):
        df = pl.DataFrame([data])
    elif isinstance(data, list):
        if not data:
            raise HTTPException(
                status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
                detail="Empty records list provided.",
            )
        df = pl.DataFrame(data)
    else:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail=f"Unsupported input data format: {type(data).__name__}",
        )

    try:
        df = replay_frozen_lineage(df, frozen_lineage, fail_fast_mode=True)
    except RecipeValidationError as exc:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail=str(exc),
        ) from exc
    except Exception as exc:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail=f"Frozen pipeline replay failed: {exc}",
        ) from exc

    if df.height == 0:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail="All input records were rejected by the frozen recipe.",
        )

    # Check required feature columns
    missing = [c for c in feature_columns if c not in df.columns]
    if missing:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail=f"Missing required feature columns: {missing}",
        )

    X_raw = df.select(feature_columns).to_numpy()
    try:
        X_trans = transformer.transform(X_raw)
    except Exception as exc:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail=f"Preprocessing transform failed: {exc}",
        ) from exc
    return X_trans


@app.get("/health")
def health_check() -> Dict[str, str]:
    """Healthcheck probe for container orchestration."""
    return {"status": "healthy", "service": "dataiki-standalone-api"}


@app.get("/model_info")
def model_info() -> Dict[str, Any]:
    """Inspect model version and metadata."""
    return {
        "project_key": "{{ project_key }}",
        "version": bundle.get("version", 1),
        "task_type": task_type,
        "algorithm": algorithm,
        "target_column": target_column,
        "feature_columns": feature_columns,
        "metrics": metrics,
        "hyperparameters": hyperparameters,
    }


@app.post("/predict")
def predict(req: PredictionRequest) -> Dict[str, Any]:
    """Generate model predictions."""
    is_single = isinstance(req.records, dict)
    X_trans = _prepare_features(req.records)
    preds = model.predict(X_trans)

    if label_encoder is not None:
        preds = label_encoder.inverse_transform(preds)

    pred_list = preds.tolist() if isinstance(preds, np.ndarray) else list(preds)
    return {
        "target_column": target_column,
        "predictions": pred_list[0] if is_single else pred_list,
    }


@app.post("/predict_proba")
def predict_proba(req: PredictionRequest) -> Dict[str, Any]:
    """Generate class probabilities for classification models."""
    if not hasattr(model, "predict_proba"):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Model '{algorithm}' does not support predict_proba.",
        )
    is_single = isinstance(req.records, dict)
    X_trans = _prepare_features(req.records)
    probas = model.predict_proba(X_trans)
    proba_list = probas.tolist() if isinstance(probas, np.ndarray) else list(probas)
    return {
        "probabilities": proba_list[0] if is_single else proba_list,
    }


if __name__ == "__main__":
    import uvicorn
    uvicorn.run("standalone_api:app", host="0.0.0.0", port=8000, reload=False)
