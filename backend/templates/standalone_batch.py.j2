from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional, Union

import joblib
import numpy as np
import polars as pl

BUNDLE_PATH = Path(__file__).parent / "bundle.joblib"
if not BUNDLE_PATH.exists():
    raise FileNotFoundError(f"Missing bundle.joblib at {BUNDLE_PATH}")

bundle = joblib.load(BUNDLE_PATH)
model = bundle["model"]
transformer = bundle["transformer"]
label_encoder = bundle.get("label_encoder")
feature_columns: List[str] = bundle.get("feature_columns", [])
target_column: str = bundle.get("target_column", "target")


def predict_dataframe(df: pl.DataFrame) -> pl.DataFrame:
    """Take an input Polars DataFrame, compute predictions, and return enriched DataFrame."""
    missing = [c for c in feature_columns if c not in df.columns]
    if missing:
        raise ValueError(f"Input DataFrame is missing required feature columns: {missing}")

    X_raw = df.select(feature_columns).to_numpy()
    X_trans = transformer.transform(X_raw)
    preds = model.predict(X_trans)

    if label_encoder is not None:
        preds = label_encoder.inverse_transform(preds)

    pred_col = f"prediction_{target_column}"
    enriched_df = df.with_columns(pl.Series(name=pred_col, values=preds))

    if hasattr(model, "predict_proba"):
        try:
            probas = model.predict_proba(X_trans)
            if probas.ndim > 1 and probas.shape[1] == 2:
                enriched_df = enriched_df.with_columns(
                    pl.Series(name=f"probability_{target_column}", values=probas[:, 1])
                )
        except Exception:
            pass

    return enriched_df


def batch_score_file(input_path: str, output_path: str) -> None:
    """Read tabular file (csv, parquet, xlsx), compute predictions, and write to output path."""
    in_p = Path(input_path)
    out_p = Path(output_path)
    ext = in_p.suffix.lower()

    print(f"[Dataiki Standalone Batch] Loading '{input_path}'...")
    if ext == ".parquet":
        df = pl.read_parquet(in_p)
    elif ext in [".csv", ".txt"]:
        df = pl.read_csv(in_p)
    elif ext in [".xlsx", ".xls"]:
        df = pl.read_excel(in_p)
    else:
        raise ValueError(f"Unsupported file format: {ext}")

    print(f"[Dataiki Standalone Batch] Scoring {df.height} records with {bundle.get('algorithm')}...")
    scored_df = predict_dataframe(df)

    out_ext = out_p.suffix.lower()
    out_p.parent.mkdir(parents=True, exist_ok=True)
    if out_ext == ".parquet":
        scored_df.write_parquet(out_p)
    elif out_ext in [".csv", ".txt"]:
        scored_df.write_csv(out_p)
    elif out_ext in [".xlsx", ".xls"]:
        scored_df.write_excel(out_p)
    else:
        scored_df.write_csv(out_p)

    print(f"[Dataiki Standalone Batch] Successfully wrote scored data to '{output_path}'.")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Dataiki Standalone Batch Predictor")
    parser.add_argument("--input", "-i", required=True, help="Path to input dataset (.csv, .parquet, .xlsx)")
    parser.add_argument("--output", "-o", required=True, help="Path to output dataset destination")
    args = parser.parse_args()
    batch_score_file(args.input, args.output)

